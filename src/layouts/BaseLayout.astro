---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Craig Chandler — Solution Architect & Decision Intelligence Specialist',
  description = 'Craig Chandler designs and builds analytical software for complex operational systems, bridging software, cloud, operational modelling, and decision intelligence.',
  image = '/assets/social-preview.png',
  type = 'website'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Craig Chandler',
  url: 'https://craigchandler.xyz',
  image: 'https://craigchandler.xyz/assets/images/craig-chandler.webp',
  jobTitle: ['Solution Architect', 'Software Architect', 'Cloud Architect', 'Decision Intelligence Specialist'],
  worksFor: {
    '@type': 'Organization',
    name: 'InterDynamics Pty Ltd',
    url: 'https://www.interdynamics.com'
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'The University of Adelaide'
  },
  sameAs: [
    'https://github.com/craigchandler',
    'https://www.linkedin.com/in/craig-chandler/'
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171918" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Craig Chandler" />
    <meta property="og:locale" content="en_AU" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
