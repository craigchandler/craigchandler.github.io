---
import type { DiagramType } from '../content/work';

interface Props {
  type: DiagramType;
  compact?: boolean;
}

const { type, compact = false } = Astro.props;

const diagrams = {
  fatigue: {
    label: 'Platform architecture',
    context: 'One analytical capability · three delivery models',
    description:
      'FAID analytical capability is delivered through three integration surfaces: the Angular and .NET FAID Quantum web application, a managed developer API using Azure API Management and .NET Azure Functions, and a native C++ shared library embedded in third-party software. The developer API uses separate controls for API subscription access and product entitlement, with entitlement validated by the InterDynamics Licensing Platform.',
    caption:
      'Interactive, managed API and local native integrations use the same analytical capability; developer API access and product entitlement remain separate controls.'
  },
  platform: {
    label: 'Workload architecture',
    context: 'Interactive control plane and isolated compute',
    description:
      'The Angular client and application API form an interactive control plane. They persist scenario configuration, submit asynchronous work and report status. A separate compute plane orchestrates isolated container runs, with cloud storage holding inputs, execution state and results.',
    caption:
      'The browser submits and observes work through durable state; long-running compute continues independently.'
  },
  control: {
    label: 'Control architecture',
    context: 'Network state to movement authority',
    description:
      'An abstract railway schematic shows a following train behind a lead train, plus a switch to an unavailable branch. Observed topology, train position, route and switch state, restrictions and reservations enter a C++ control core. It evaluates routes, following separation, conflict resources, movement authority and speed. Planimate applies returned commands, advances the simulation and supplies the next observed state through the native interface.',
    caption:
      'A closed control loop: observed railway state in, revisioned authority and speed commands out, then fresh state back on the next step.'
  },
  'supply-chain': {
    label: 'Operational model',
    context: 'System boundary and decision outputs',
    description:
      'A discrete-event model follows material and fleet through mine or source, stockpile and loadout, the rail network, port or plant unloading, and the empty return cycle. Schedules, maintenance, delays, infrastructure, operating rules and fleet availability influence the entire cycle. Outputs include throughput, utilisation, queues, cycle times, bottlenecks and scenario comparisons.',
    caption:
      'Loaded movement runs to the destination; the empty fleet returns through the network to begin the next cycle.'
  }
} as const;

const diagram = diagrams[type];
const titleId = `${type}-diagram-title`;
const descriptionId = `${type}-diagram-description`;
const captionId = `${type}-diagram-caption`;
---

<figure
  class:list={['architecture-diagram', `architecture-diagram-${type}`, { compact }]}
  aria-labelledby={titleId}
  aria-describedby={`${descriptionId} ${captionId}`}
>
  <div class="diagram-meta">
    <span id={titleId}>{diagram.label}</span>
    <span>{diagram.context}</span>
  </div>
  <p id={descriptionId} class="visually-hidden">{diagram.description}</p>

  {type === 'fatigue' && (
    <div class="diagram-canvas diagram-faid">
      <div class="diagram-faid-delivery">
        <div class="diagram-boundary-heading">
          <span>Delivery surfaces</span>
          <strong>Choose the integration model that fits the consuming system</strong>
        </div>
        <div class="diagram-faid-surface-grid">
          <div class="diagram-node diagram-node-emphasis diagram-faid-surface">
            <small>Interactive product</small>
            <strong>FAID Quantum web application</strong>
            <span>Angular · .NET</span>
            <em>Identity · organisation context · reporting</em>
          </div>
          <div class="diagram-node diagram-faid-surface">
            <small>Managed integration</small>
            <strong>FAID Developer API</strong>
            <span>Azure API Management · .NET Azure Functions</span>
            <em>Developer subscription credential</em>
          </div>
          <div class="diagram-node diagram-faid-surface">
            <small>Native integration</small>
            <strong>C++ shared library</strong>
            <span>Embedded in third-party software</span>
            <em>No remote service dependency</em>
          </div>
        </div>
      </div>

      <div class="diagram-faid-convergence" aria-hidden="true">
        <span>Delivery-specific adapters</span>
        <i>↓</i>
      </div>

      <div class="diagram-boundary diagram-faid-engine">
        <div class="diagram-boundary-heading">
          <span>Shared analytical capability</span>
          <strong>FAID fatigue engine</strong>
        </div>
        <div class="diagram-faid-engine-flow">
          <span>Work &amp; sleep data</span>
          <i aria-hidden="true">→</i>
          <div class="diagram-node diagram-node-emphasis">
            <small>Analytical core</small>
            <strong>FAID analytical algorithms</strong>
          </div>
          <i aria-hidden="true">→</i>
          <span>Fatigue outputs &amp; risk measures</span>
        </div>
      </div>

      <div class="diagram-faid-support">
        <div class="diagram-boundary-heading">
          <span>Supporting platform services</span>
          <strong>Controls remain explicit to the delivery surface</strong>
        </div>
        <div class="diagram-faid-support-grid">
          <div>
            <small>Web application</small>
            <strong>Identity &amp; organisation</strong>
            <span>Auth0 · tenant context</span>
          </div>
          <div>
            <small>Developer API access</small>
            <strong>Subscription credential</strong>
            <span>Gateway access control</span>
          </div>
          <div>
            <small>Developer API entitlement</small>
            <strong>Licensing platform</strong>
            <span>Product licence validation</span>
          </div>
          <div>
            <small>Web application</small>
            <strong>Schedules &amp; reporting</strong>
            <span>Tenant-scoped persistence</span>
          </div>
        </div>
      </div>
    </div>
  )}

  {type === 'platform' && (
    <div class="diagram-canvas diagram-dash">
      <div class="diagram-plane diagram-control-plane">
        <div class="diagram-boundary-heading">
          <span>Plane 01</span>
          <strong>Interactive / control plane</strong>
        </div>
        <div class="diagram-stage-row">
          <div class="diagram-node">
            <small>User workflow</small>
            <strong>Projects · studies · scenarios</strong>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node diagram-node-emphasis">
            <small>Browser</small>
            <strong>Angular client</strong>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node">
            <small>Application service</small>
            <strong>.NET API</strong>
            <span>Configure · submit · monitor</span>
          </div>
        </div>
      </div>

      <div class="diagram-async-bridge">
        <span><i aria-hidden="true">↓</i> Execution request</span>
        <strong>Asynchronous boundary</strong>
        <span>Progress + results <i aria-hidden="true">↑</i></span>
      </div>

      <div class="diagram-plane diagram-compute-plane">
        <div class="diagram-boundary-heading">
          <span>Plane 02</span>
          <strong>Isolated compute plane</strong>
        </div>
        <div class="diagram-stage-row">
          <div class="diagram-node">
            <small>Control service</small>
            <strong>Workload orchestration</strong>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node diagram-node-emphasis">
            <small>Disposable workers</small>
            <strong>Container runs</strong>
            <span>Staged / parallel work</span>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node">
            <small>Post-run</small>
            <strong>Result aggregation</strong>
          </div>
        </div>
      </div>

      <div class="diagram-persistence">
        <div class="diagram-boundary-heading">
          <span>Durable layer</span>
          <strong>Persisted independently of workers</strong>
        </div>
        <div class="diagram-persistence-list">
          <span>Scenario configuration</span>
          <span>Workload inputs</span>
          <span>Execution state</span>
          <span>Analytical outputs</span>
        </div>
      </div>
    </div>
  )}

  {type === 'control' && (
    <div class="diagram-canvas diagram-moving-block">
      <div class="diagram-state-panel">
        <div class="diagram-boundary-heading">
          <span>Observed inputs</span>
          <strong>Railway state</strong>
        </div>
        <div
          class="diagram-topology-cue"
          role="img"
          aria-label="Abstract railway topology showing a following train behind a lead train on the main route, with a switch to an unavailable branch"
        >
          <i class="topology-line topology-main" aria-hidden="true"></i>
          <i class="topology-line topology-branch" aria-hidden="true"></i>
          <span class="topology-switch" aria-hidden="true"></span>
          <span class="topology-train topology-following"><small>Following</small></span>
          <span class="topology-train topology-leading"><small>Lead</small></span>
          <span class="topology-blocked" aria-hidden="true">×</span>
          <small class="topology-label">Branch unavailable</small>
        </div>
        <div class="diagram-state-list">
          <span>Network topology</span>
          <span>Train front / rear</span>
          <span>Routes &amp; switches</span>
          <span>Restrictions</span>
          <span>Occupancy &amp; reservations</span>
        </div>
      </div>

      <div class="diagram-control-link" aria-hidden="true"><span>Observed state</span><i>→</i></div>

      <div class="diagram-controller-core">
        <div class="diagram-boundary-heading">
          <span>C++ control core</span>
          <strong>Current-state evaluation</strong>
        </div>
        <div class="diagram-logic-grid">
          <span>Route evaluation</span>
          <span>Following / headway</span>
          <span>Conflict reservations</span>
          <span>Movement authority</span>
          <span>Speed decisions</span>
        </div>
      </div>

      <div class="diagram-control-link" aria-hidden="true"><span>Revised commands</span><i>→</i></div>

      <div class="diagram-command-panel">
        <div class="diagram-boundary-heading">
          <span>Controller outputs</span>
          <strong>Authority &amp; commands</strong>
        </div>
        <div class="diagram-state-list">
          <span>Position limit</span>
          <span>Route / hold</span>
          <span>Speed profile</span>
          <span>Next recheck</span>
        </div>
      </div>

      <div class="diagram-host-boundary">
        <div>
          <small>Simulation host</small>
          <strong>Planimate owns clock, events and train movement</strong>
        </div>
        <div class="diagram-host-cycle">
          <span>Apply current commands</span>
          <i aria-hidden="true">→</i>
          <span>Advance simulation</span>
          <i aria-hidden="true">→</i>
          <span>Return fresh observed state</span>
          <b aria-hidden="true">↺</b>
        </div>
        <div class="diagram-platforms">
          <span>Native table interface</span>
          <span>Windows DLL</span>
          <span>Linux shared library</span>
        </div>
      </div>
    </div>
  )}

  {type === 'supply-chain' && (
    <div class="diagram-canvas diagram-rail-model">
      <div class="diagram-influences">
        <div class="diagram-boundary-heading">
          <span>Model inputs</span>
          <strong>Conditions affecting the whole cycle</strong>
        </div>
        <div class="diagram-chip-row">
          <span>Schedules</span>
          <span>Maintenance</span>
          <span>Stochastic delay</span>
          <span>Infrastructure</span>
          <span>Operating rules</span>
          <span>Fleet availability</span>
        </div>
      </div>

      <div class="diagram-operating-cycle">
        <div class="diagram-boundary-heading">
          <span>Discrete-event simulation boundary</span>
          <strong>Mine-to-destination operating cycle</strong>
        </div>
        <div class="diagram-cycle-row">
          <div class="diagram-node">
            <small>01</small>
            <strong>Mine / source</strong>
            <span>Material release</span>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node">
            <small>02</small>
            <strong>Stockpile / loadout</strong>
            <span>Queue · load · depart</span>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node diagram-node-emphasis">
            <small>03</small>
            <strong>Rail fleet &amp; network</strong>
            <span>Travel · meet · pass · wait</span>
          </div>
          <span class="diagram-arrow" aria-hidden="true">→</span>
          <div class="diagram-node">
            <small>04</small>
            <strong>Port / plant</strong>
            <span>Queue · unload · release</span>
          </div>
        </div>
        <div class="diagram-return-path">
          <i aria-hidden="true">←</i>
          <span><strong>Empty fleet return</strong> · network back to the next loading cycle</span>
          <b aria-hidden="true">↵</b>
        </div>
        <p class="diagram-shared-state">Shared state: queues · asset availability · fleet position · current events</p>
      </div>

      <div class="diagram-decision-outputs">
        <div class="diagram-boundary-heading">
          <span>Decision outputs</span>
          <strong>Compare whole-system behaviour</strong>
        </div>
        <div class="diagram-output-grid">
          <span>Throughput</span>
          <span>Utilisation</span>
          <span>Queues</span>
          <span>Cycle times</span>
          <span>Bottlenecks</span>
          <span>Scenarios</span>
        </div>
      </div>
    </div>
  )}

  <figcaption id={captionId}>{diagram.caption}</figcaption>
</figure>
