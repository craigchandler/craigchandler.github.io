          <span>VitisAIExecutionProvider</span>
          <div class="npu-stack-runtime">
            <strong>XRT 2.26.0</strong>
            <span>XDNA userspace plugin 2.26.0</span>
          </div>
        </div>
      </div>
      <div class="npu-stack-layer">
