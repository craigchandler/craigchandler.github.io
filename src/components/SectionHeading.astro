---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  headingId?: string;
}

const { eyebrow, title, intro, headingId } = Astro.props;
---

<header class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <div class="section-heading-copy">
    <h2 id={headingId}>{title}</h2>
    {intro && <p>{intro}</p>}
  </div>
</header>
