---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import CaseImage from '../../components/CaseImage.astro';
import CaseFacts from '../../components/CaseFacts.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { work, type WorkItem } from '../../content/work';

export function getStaticPaths() {
  return work.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: WorkItem;
}

const { project } = Astro.props;
const related = work.filter((item) => item.slug !== project.slug).slice(0, 2);
const pageUrl = new URL(`/work/${project.slug}/`, Astro.site).toString();
const siteUrl = new URL('/', Astro.site).toString();
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;
const projectId = `${pageUrl}#project`;
const socialImage = new URL(project.metadata.image, Astro.site).toString();

const projectEntity = {
  '@type': project.metadata.entityType,
  '@id': projectId,
  name: project.title,
  description: project.metadata.description,
  url: pageUrl,
  creator: { '@id': personId },
  ...(project.metadata.applicationCategory
    ? { applicationCategory: project.metadata.applicationCategory }
    : {})
};

const article = {
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: project.title,
  description: project.metadata.description,
  url: pageUrl,
  image: socialImage,
  author: { '@id': personId },
  isPartOf: { '@id': websiteId },
  inLanguage: 'en',
  about: { '@id': projectId }
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Craig Chandler', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: project.title, item: pageUrl }
  ]
};
---

<BaseLayout
  title={project.metadata.title}
  description={project.metadata.description}
  image={project.metadata.image}
  imageAlt={project.metadata.imageAlt}
  type="article"
  structuredData={[projectEntity, article, breadcrumb]}
>
  <article class:list={['case-study', `case-study-${project.slug}`]}>
    <header class="case-hero container-wide">
      <a class="back-link" href="/#work"><span aria-hidden="true">←</span> Selected work</a>
      <div class="case-title-grid">
        <div>
          <p class="eyebrow">Case study / {project.number}</p>
          <h1>
            {project.titleSegments
              ? project.titleSegments.map((segment, index) => (
                  <Fragment>
                    <span class="case-title-segment">{segment}</span>
                    {index < project.titleSegments!.length - 1 && ' '}
                  </Fragment>
                ))
              : project.title}
          </h1>
        </div>
        <div class="case-summary">
          <p class="case-kicker">{project.kicker}</p>
          <p>{project.summary}</p>
        </div>
      </div>
    </header>

    <section class="case-diagram container-wide" aria-label="System overview">
      <ArchitectureDiagram type={project.diagram} />
    </section>

    {!project.sections.some((section) => section.figure === 'image') && <CaseImage project={project} />}

    <section class="case-body container-wide">
      <CaseFacts project={project} />
      <div class="case-narrative">
        {project.sections.map((section, index) => (
          <section id={`case-section-${String(index + 1).padStart(2, '0')}`}>
            <p class="eyebrow">{section.label}</p>
            <h2>{section.title}</h2>
            <div class="case-copy">
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            {section.points && (
              <ul class="case-points">
                {section.points.map((point) => <li>{point}</li>)}
              </ul>
            )}
            {(section.subsections ?? (section.subsection ? [section.subsection] : [])).map((subsection) => (
              <div class="case-subsection">
                <h3>{subsection.title}</h3>
                <div class="case-copy">
                  {subsection.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </div>
            ))}
            {section.figure === 'image' && <CaseImage project={project} inline />}
          </section>
        ))}
        {project.externalLinks && (
          <div class="case-links">
            {project.externalLinks.map((link) => (
              <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>
            ))}
          </div>
        )}
        {project.furtherReading && (
          <aside class="case-further-reading" aria-label="Further reading">
            <p class="eyebrow">Further reading</p>
            {project.furtherReading.map((link) => (
              <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>
            ))}
          </aside>
        )}
      </div>
    </section>

    <section class="related-work section-ruled">
      <div class="container-wide">
        <div class="related-heading">
          <p class="eyebrow">Continue exploring</p>
          <h2>Related work</h2>
        </div>
        <div class="projects-grid related-grid">
          {related.map((item) => <ProjectCard project={item} />)}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
