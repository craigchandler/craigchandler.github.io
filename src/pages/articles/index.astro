---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articles } from '../../content/articles';

const pageUrl = new URL('/articles/', Astro.site).toString();
const siteUrl = new URL('/', Astro.site).toString();
const description =
  'Technical writing on operational modelling, simulation architecture, analytical software, rail systems, and cloud and software architecture.';

const collection = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  name: 'Articles',
  description,
  url: pageUrl,
  isPartOf: { '@id': `${siteUrl}#website` },
  inLanguage: 'en'
};

const breadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Craig Chandler', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: pageUrl }
  ]
};
---

<BaseLayout
  title="Articles — Technical Writing | Craig Chandler"
  description={description}
  structuredData={[collection, breadcrumb]}
>
  <div class="articles-page">
    <header class="articles-header container-wide">
      <a class="back-link" href="/"><span aria-hidden="true">←</span> Home</a>
      <p class="eyebrow">Technical writing</p>
      <h1>Articles</h1>
      <p>
        Technical writing on operational modelling, simulation architecture, analytical software, rail systems, and
        cloud and software architecture.
      </p>
    </header>

    <section class="articles-list container-wide" aria-label="Published articles">
      {articles.map((article) => (
        <article>
          <time datetime={article.published}>
            {new Date(`${article.published}T00:00:00+09:30`).toLocaleDateString('en-AU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            })}
          </time>
          <div>
            <h2><a href={`/articles/${article.slug}/`}>{article.title}</a></h2>
            <p>{article.subtitle}</p>
            <a class="text-link" href={`/articles/${article.slug}/`}>Read article <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
